# Ghost Protocol — Environment Configuration Template
# Copy this file to .env for local overrides (never commit real credentials)

# Server Configuration
GHOST_HOST=127.0.0.1
GHOST_PORT=8000
GHOST_DEBUG=false

# Persistence & Storage
GHOST_DB_PATH=evidence/evidence.db
GHOST_OUTPUT_LIMIT_BYTES=65536
GHOST_SUBPROCESS_TIMEOUT_SECONDS=30

# Security & Access Control (Optional API Key for non-loopback protection)
# GHOST_API_KEY=your-secure-local-token-here

# CORS Allowed Origins (Comma-separated list of trusted dev clients)
GHOST_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration (used by Vite in frontend/.env)
VITE_API_URL=http://localhost:8000
